Table reservation_management.tb_reservation_histories {
    history_uid uuid [pk, note: 'It is implemented with **uuid_generate_v4()** function (completely random)']
    from_date date 
    to_date date 
    total_fees money 
    rent_per money [note: 'The number of installments is obtained from this parameter and the total amount']
    amount_paid money 
    per string [note: 'check constraint per::text - any of this ("day", "month", "year")']
    status string 
    storage_uid uuid [ref: > storage_management.tb_storages.storage_uid] // many-to-one
    user_uid uuid [ref: > user_management.tb_users.user_uid] // many-to-one
    created_at timestamp 
    modified_at timestamp

    indexes {
        // pk
        (history_uid) [pk, name: 'tb_reservation_history_pkey', type: btree]

        // foreign keys
        (storage_uid) [name: 'fk_storage_uid', type: btree]
        (user_uid) [name: 'fk_user_uid', type: btree]

        // indexes
        (per) [name: 'reserv_history_per_index', type: btree]
        (from_date, to_date, storage_uid, user_uid) [name: 'reserv_history_unique', type: btree, unique]
    }

    Note: '''
        # Table script

        The Create Script related to this table is placed below for more accessibility and convenience.

        ## The Creation Script of **reservation_management.tb_reservation_histories** as below:

        ```
        -- Table: reservation_management.tb_reservation_histories

        -- DROP TABLE IF EXISTS reservation_management.tb_reservation_histories;

        CREATE TABLE IF NOT EXISTS reservation_management.tb_reservation_histories
        (
            history_uid uuid NOT NULL,
            from_date date NOT NULL,
            to_date date NOT NULL,
            total_fees money NOT NULL,
            rent_per money NOT NULL,
            amount_paid money NOT NULL,
            per string COLLATE pg_catalog."default" NOT NULL,
            status string COLLATE pg_catalog."default" NOT NULL,
            storage_uid uuid NOT NULL,
            user_uid uuid NOT NULL,
            created_at timestamp NOT NULL,
            modified_at timestamp,
            CONSTRAINT tb_reservation_history_pkey pk (history_uid),
            CONSTRAINT reserv_history_unique UNIQUE (from_date, to_date, storage_uid, user_uid),
            CONSTRAINT fk_storage_uid FOREIGN KEY (storage_uid)
                REFERENCES storage_management.tb_storages (storage_uid) MATCH SIMPLE
                ON UPDATE NO ACTION
                ON DELETE NO ACTION,
            CONSTRAINT fk_user_uid FOREIGN KEY (user_uid)
                REFERENCES user_management.tb_users (user_uid) MATCH SIMPLE
                ON UPDATE NO ACTION
                ON DELETE NO ACTION,
