Project Hamasye {
    database_type: 'PostgreSQL'
    Note: '''
        # db_hamasye Database
        ### version: 1.0.0

        It contains all stuff about main component of hamsaye project such as:
        - storage management
        - user management
        - financial management

        Note: This partitions are temporarily in **db_hamsaye** and it might be in another database for more convenience and order in the system in future.
    '''
}

Table user_management.tb_users {
    user_uid uuid [pk, note: 'It is implemented with **uuid_generate_v4()** function (completely random)']
    nid string [note: 'It is an abbreviation for **national code**']
    phone string [note: 'foramt: 9120009988']
    first_name string 
    last_name string 
    enabled boolean 
    password text 
    profile_img text 
    become_host boolean 
    status string 
    created_at timestamp 
    modified_at timestamp

    indexes {
        // pk
        (user_uid) [pk, name: 'tb_user_pkey', type: btree]

        // unique constraints
        (nid) [name: 'nid_unique', type: btree, unique]
        (phone) [name: 'phone_unique', type: btree, unique]
    }

    Note: '''
        # Table script

        The Create Script related to this table is placed below for more accessibility and convenience.

        ## The Creation Script of **user_management.tb_users** as below:

        ```
        -- Table: user_management.tb_users

        -- DROP TABLE IF EXISTS user_management.tb_users;

        CREATE TABLE IF NOT EXISTS user_management.tb_users
        (
            user_uid uuid NOT NULL,
            nid string COLLATE pg_catalog."default" NOT NULL,
            phone string COLLATE pg_catalog."default" NOT NULL,
            first_name string COLLATE pg_catalog."default" NOT NULL,
            last_name string COLLATE pg_catalog."default" NOT NULL,
            enabled boolean NOT NULL,
            password text COLLATE pg_catalog."default" NOT NULL,
            profile_img text COLLATE pg_catalog."default",
            become_host boolean NOT NULL,
            status string COLLATE pg_catalog."default" NOT NULL,
            created_at timestamp NOT NULL,
            modified_at timestamp,
            CONSTRAINT tb_user_pkey pk (user_uid),
            CONSTRAINT nid_unique UNIQUE (nid),
            CONSTRAINT phone_unique UNIQUE (phone)
        )

        /* allow database administrators to define locations in the file system where the files */
        TABLESPACE pg_default;

        ALTER TABLE IF EXISTS user_management.tb_users
            OWNER to postgres;
        -- Index: nid_index

        -- DROP INDEX IF EXISTS user_management.nid_index;

        CREATE INDEX IF NOT EXISTS nid_index
            ON user_management.tb_users USING btree
            (nid COLLATE pg_catalog."default" ASC NULLS LAST)
            TABLESPACE pg_default;
        -- Index: phone_index

        -- DROP INDEX IF EXISTS user_management.phone_index;

        CREATE INDEX IF NOT EXISTS phone_index
            ON user_management.tb_users USING btree
            (phone COLLATE pg_catalog."default" ASC NULLS LAST)
            TABLESPACE pg_default;
        ```
    '''

}

Table storage_management.tb_storages {
    storage_uid uuid [pk, note: 'It is implemented with **uuid_generate_v4()** function (completely random)']
    width integer 
    height integer 
    max_weight integer
    amount money 
    discount_amt decimal 
    description string
    status string 
    user_uid uuid [ref: > user_management.tb_users.user_uid] // many-to-one
    category_uid uuid [ref: > storage_management.tb_storage_categories.category_uid] // many-to-one
    category_topic string [note: 'This feild should be updated every time that we change topic of each category']
    created_at timestamp 
    modified_at timestamp

    indexes {
        // pk
        (storage_uid) [pk, name: 'tb_storage_pkey', type: btree]

        // foreign keys
        (category_uid) [name: 'fk_category_uid', type: btree]
        (user_uid) [name: 'fk_user_uid', type: btree]

        // indexes
        (category_topic) [name: '', type: btree]
    }

    Note: '''
        # Table script

        The Create Script related to this table is placed below for more accessibility and convenience.

        ## The Creation Script of **storage_management.tb_storages** as below:

        ```
        -- Table: storage_management.tb_storages

        -- DROP TABLE IF EXISTS storage_management.tb_storages;

        CREATE TABLE IF NOT EXISTS storage_management.tb_storages
        (
            storage_uid uuid NOT NULL,
            width integer NOT NULL,
            height integer NOT NULL,
            max_weight integer,
            amount money NOT NULL,
            discount_amt decimal NOT NULL,
            description string COLLATE pg_catalog."default",
            status string COLLATE pg_catalog."default" NOT NULL,
            user_uid uuid NOT NULL,
            category_uid uuid NOT NULL,
            category_topic string COLLATE pg_catalog."default" NOT NULL,
            created_at timestamp NOT NULL,
            modified_at timestamp,
            CONSTRAINT tb_storage_pkey pk (storage_uid),
            CONSTRAINT fk_category_uid FOREIGN KEY (category_uid)
                REFERENCES storage_management.tb_storage_categories (category_uid) MATCH SIMPLE
                ON UPDATE NO ACTION
                ON DELETE NO ACTION,
            CONSTRAINT fk_user_uid FOREIGN KEY (user_uid)
                REFERENCES user_management.tb_users (user_uid) MATCH SIMPLE
                ON UPDATE NO ACTION
                ON DELETE NO ACTION
        )

        /* allow database administrators to define locations in the file system where the files */
        TABLESPACE pg_default;

        ALTER TABLE IF EXISTS storage_management.tb_storages
            OWNER to postgres;
        -- Index: category_topic_index

        -- DROP INDEX IF EXISTS storage_management.category_topic_index;

        CREATE INDEX IF NOT EXISTS category_topic_index
            ON storage_management.tb_storages USING btree
            (category_topic COLLATE pg_catalog."default" ASC NULLS LAST)
            TABLESPACE pg_default;
        ```
    '''

}

Table storage_management.tb_storage_reviews {
    review_uid uuid [pk, note: 'It is implemented with **uuid_generate_v4()** function (completely random)']
    writer_id uuid 
    writer_comment string 
    owner_id uuid
    owner_comment string
    rating real 
    edited boolean 
    has_been_answered boolean 
    status string 
    storage_uid uuid [ref: > storage_management.tb_storages.storage_uid] // many-to-one
    created_at timestamp 
    modified_at timestamp

    indexes {
        // pk
        (review_uid) [pk, name: 'tb_storage_reviews_pkey', type: btree]

        // foreign keys
        (storage_uid) [name: 'fk_storage_uid', type: btree]

        // indexes
        (writer_id, owner_id, storage_uid) [name: 'review_unique', type: btree, unique]
    }

    Note: '''
        # Table script

        The Create Script related to this table is placed below for more accessibility and convenience.

        ## The Creation Script of **storage_management.tb_storage_reviews** as below:

        ```
        -- Table: storage_management.tb_storage_reviews

        -- DROP TABLE IF EXISTS storage_management.tb_storage_reviews;

        CREATE TABLE IF NOT EXISTS storage_management.tb_storage_reviews
        (
            review_uid uuid NOT NULL,
            writer_id uuid NOT NULL,
            writer_comment string COLLATE pg_catalog."default" NOT NULL,
            owner_id uuid,
            owner_comment string COLLATE pg_catalog."default",
            rating real NOT NULL,
            edited boolean NOT NULL,
            has_been_answered boolean NOT NULL,
            status string COLLATE pg_catalog."default" NOT NULL,
            storage_uid uuid NOT NULL,
            created_at timestamp NOT NULL,
            modified_at timestamp,
            CONSTRAINT tb_storage_reviews_pkey pk (review_uid),
            CONSTRAINT review_unique UNIQUE (writer_id, owner_id, storage_uid),
            CONSTRAINT fk_storage_uid FOREIGN KEY (storage_uid)
                REFERENCES storage_management.tb_storages (storage_uid) MATCH SIMPLE
                ON UPDATE NO ACTION
                ON DELETE NO ACTION
        )

        /* allow database administrators to define locations in the file system where the files */
        TABLESPACE pg_default;

        ALTER TABLE IF EXISTS storage_management.tb_storage_reviews
            OWNER to postgres;
        ```
    '''

}

