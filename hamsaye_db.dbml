// interface table for (tb_storages, tb_storage_features)
Table storage_management.tb_feature_of_storages {
    feature_uid uuid [ref: > storage_management.tb_storage_features.feature_uid]
    storage_uid uuid [ref: > storage_management.tb_storages.storage_uid]

    indexes {
        // foreign keys
        (feature_uid) [name: 'fk_feature_uid', type: btree]
        (storage_uid) [name: 'fk_storage_uid', type: btree]

        // indexes
        (feature_uid, storage_uid) [name: 'feature_storage_unique', type: btree, unique]
    }

    Note: '''
        # Table script

        The Create Script related to this table is placed below for more accessibility and convenience.

        ## The Creation Script of **storage_management.tb_feature_of_storages** as below:

        ```
        -- Table: storage_management.tb_feature_of_storages

        -- DROP TABLE IF EXISTS storage_management.tb_feature_of_storages;

        CREATE TABLE IF NOT EXISTS storage_management.tb_feature_of_storages
        (
            feature_uid uuid NOT NULL,
            storage_uid uuid NOT NULL,
            CONSTRAINT feature_storage_unique UNIQUE (feature_uid, storage_uid),
            CONSTRAINT fk_feature_uid FOREIGN KEY (feature_uid)
                REFERENCES storage_management.tb_storage_features (feature_uid) MATCH SIMPLE
                ON UPDATE NO ACTION
                ON DELETE NO ACTION,
            CONSTRAINT fk_storage_uid FOREIGN KEY (storage_uid)
                REFERENCES storage_management.tb_storages (storage_uid) MATCH SIMPLE
                ON UPDATE NO ACTION
                ON DELETE NO ACTION
        )

        TABLESPACE pg_default;

        ALTER TABLE IF EXISTS storage_management.tb_feature_of_storages
            OWNER to postgres;
        ```
    '''

}

Table storage_management.tb_bookmarks {
    // bookmark_uid uuid [pk]
    user_uid uuid [ref: > user_management.tb_users.user_uid] // many-to-one
    storage_uid uuid [ref: <> storage_management.tb_storages.storage_uid] // many-to-many
    created_at timestamp 

    indexes {
        // foreign keys
        (user_uid) [name: 'fk_user_uid', type: btree]
        (storage_uid) [name: 'fk_storage_uid', type: btree]

        // indexes
        (user_uid, storage_uid) [name: 'bookmark_unique', type: btree, unique]
    }

    Note: '''
        # Table script

        The Create Script related to this table is placed below for more accessibility and convenience.

        ## The Creation Script of **storage_management.tb_bookmarks** as below:

        ```
        -- Table: storage_management.tb_bookmarks

        -- DROP TABLE IF EXISTS storage_management.tb_bookmarks;

        CREATE TABLE IF NOT EXISTS storage_management.tb_bookmarks
        (
            user_uid uuid NOT NULL,
            storage_uid uuid NOT NULL,
            created_at timestamp NOT NULL,
            CONSTRAINT bookmark_unique UNIQUE (user_uid, storage_uid),
            CONSTRAINT fk_storage_uid FOREIGN KEY (storage_uid)
                REFERENCES storage_management.tb_storages (storage_uid) MATCH SIMPLE
                ON UPDATE NO ACTION
                ON DELETE NO ACTION,
            CONSTRAINT fk_user_uid FOREIGN KEY (user_uid)
                REFERENCES user_management.tb_users (user_uid) MATCH SIMPLE
                ON UPDATE NO ACTION
                ON DELETE NO ACTION
        )

        TABLESPACE pg_default;

        ALTER TABLE IF EXISTS storage_management.tb_bookmarks
            OWNER to postgres;
        ```
    '''

}

Table reservation_management.tb_reservations {
    reservation_uid uuid [pk, note: 'It is implemented with **uuid_generate_v4()** function (completely random)']
    from_date date 
    to_date date 
    total_fees money 
    rent_per money [note: 'The number of installments is obtained from this parameter and the total fees']
    amount_paid money 
    per string [note: 'check constraint per::text - any of this ("day", "month", "year")']
    storage_uid uuid [ref: > storage_management.tb_storages.storage_uid] // many-to-one
    user_uid uuid [ref: > user_management.tb_users.user_uid] // many-to-one
    created_at timestamp 
    modified_at timestamp

    indexes {
        // pk
        (reservation_uid) [pk, name: 'tb_reservations_pkey', type: btree]

        // foreign keys
        (storage_uid) [name: 'fk_storage_uid', type: btree]
        (user_uid) [name: 'fk_user_uid', type: btree]

        // indexes
        (per) [name: 'reserv_per_index', type: btree]
        (from_date, to_date, storage_uid, user_uid) [name: 'reserv_unique', type: btree, unique]
    }

    Note: '''
        # Table script

        The Create Script related to this table is placed below for more accessibility and convenience.

        ## The Creation Script of **reservation_management.tb_reservations** as below:

        ```
        -- Table: reservation_management.tb_reservations

        -- DROP TABLE IF EXISTS reservation_management.tb_reservations;

        CREATE TABLE IF NOT EXISTS reservation_management.tb_reservations
        (
            reservation_uid uuid NOT NULL,
            from_date date NOT NULL,
            to_date date NOT NULL,
            total_fees money NOT NULL,
            rent_per money NOT NULL,
            amount_paid money NOT NULL,
            per string COLLATE pg_catalog."default" NOT NULL,
            storage_uid uuid NOT NULL,
            user_uid uuid NOT NULL,
            created_at timestamp NOT NULL,
            modified_at timestamp,
            CONSTRAINT tb_reservations_pkey pk (reservation_uid),
            CONSTRAINT reserv_unique UNIQUE (from_date, to_date, storage_uid, user_uid),
            CONSTRAINT fk_storage_uid FOREIGN KEY (storage_uid)
                REFERENCES storage_management.tb_storages (storage_uid) MATCH SIMPLE
                ON UPDATE NO ACTION
                ON DELETE NO ACTION,
            CONSTRAINT fk_user_uid FOREIGN KEY (user_uid)
                REFERENCES user_management.tb_users (user_uid) MATCH SIMPLE
                ON UPDATE NO ACTION
                ON DELETE NO ACTION,
            CONSTRAINT reserv_per_check CHECK (per::text - ANY (ARRAY['day'::string, 'month'::string, 'year'::string]::text[]))
        )

        TABLESPACE pg_default;

        ALTER TABLE IF EXISTS reservation_management.tb_reservations
            OWNER to postgres;
        -- Index: reserv_per_index

        -- DROP INDEX IF EXISTS reservation_management.reserv_per_index;

        CREATE INDEX IF NOT EXISTS reserv_per_index
            ON reservation_management.tb_reservations USING btree
            (per COLLATE pg_catalog."default" ASC NULLS LAST)
            TABLESPACE pg_default;
        ```
    '''

}

// interface table for (tb_reservations, tb_products)
Table reservation_management.tb_reservation_products {
    reservation_uid uuid [ref: > reservation_management.tb_reservations.reservation_uid]
